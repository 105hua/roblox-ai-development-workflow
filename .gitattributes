# Normalize text files to LF in the repo and in working copies
* text=auto eol=lf

# Binary art and model sources: never touch line endings
*.blend binary
*.fbx binary
*.pcraft binary
*.psd binary
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.bmp binary
*.exr binary
*.tif binary
*.tiff binary
*.webp binary
*.dds binary
*.glb binary
